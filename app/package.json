{
  "name": "keybroker",
  "productName": "Keybroker",
  "version": "0.1.0",
  "private": true,
  "description": "Lets coding agents use your API keys without ever seeing them",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "pnpm run build:all && electron-builder --mac dir -c.mac.identity=- -c.mac.notarize=false -c.mac.entitlements=build/entitlements.adhoc.plist -c.mac.entitlementsInherit=build/entitlements.adhoc.plist",
    "ui": "vite --config vite.preview.config.ts",
    "build:all": "pnpm --filter @keybroker/cli build && pnpm run --dir .. desktop-extension && electron-vite build",
    "release": "pnpm run build:all && electron-builder --mac --publish never"
  },
  "dependencies": {
    "@keybroker/agent-api": "workspace:*",
    "@keybroker/core": "workspace:*",
    "@keybroker/proxy": "workspace:*",
    "electron-updater": "^6.8.9",
    "mockttp": "^4.6.3",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.7"
  },
  "build": {
    "appId": "com.carolinedivittorio.keybroker",
    "productName": "Keybroker",
    "directories": {
      "output": "dist",
      "buildResources": "../build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../assets",
        "to": "assets",
        "filter": [
          "*.png"
        ]
      },
      {
        "from": "../packages/cli/dist/keybroker",
        "to": "bin/keybroker"
      },
      {
        "from": "../integrations",
        "to": "integrations"
      },
      {
        "from": "../build/claude-desktop/keybroker.mcpb",
        "to": "claude-desktop/keybroker.mcpb"
      }
    ],
    "asar": true,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "../build/icon.icns",
      "identity": "Caroline di Vittorio (CDM7UWUC7U)",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "LSUIElement": true
      },
      "notarize": true
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "npmRebuild": false,
    "dmg": {
      "title": "Keybroker ${version}",
      "sign": true
    },
    "artifactName": "Keybroker-${version}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "carolinedivittorio",
        "repo": "keybroker"
      }
    ]
  },
  "author": {
    "name": "Caroline di Vittorio",
    "email": "carolinedivittorio@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/carolinedivittorio/keybroker.git"
  }
}
